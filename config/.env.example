# Database
DATABASE_URL=postgresql://kaccy_admin:YOUR_PASSWORD@localhost/kaccy_db

# JWT
JWT_SECRET=GENERATE_WITH_openssl_rand_base64_48

# Server
HOST=0.0.0.0
PORT=8080

# Bitcoin Core RPC (testnet for development)
BITCOIN_RPC_URL=http://127.0.0.1:18332
BITCOIN_RPC_USER=kaccy
BITCOIN_RPC_PASSWORD=YOUR_RPC_PASSWORD

# Logging
RUST_LOG=kaccy_api=debug,tower_http=debug
